# Generated by scripts/agent-loops/provision-machine.sh; rerun install instead of editing.
[Unit]
Description=Poll Project Admin (rocket) configured x deploy every 900s

[Timer]
# First fire shortly after install or login (launchd's RunAtLoad), staggered.
OnActiveSec=11s
