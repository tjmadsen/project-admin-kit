{
  "$schema": "./project-admin.config.schema.json",
  "schemaVersion": 1,
  "project": {
    "name": "My Project",
    "shortName": "My Project",
    "slug": "my-project",
    "description": "Product operations and autonomous delivery control room",
    "productionUrl": "https://example.com",
    "vercelProductionUrl": "https://example.com",
    "adminPath": "/admin",
    "firebaseProjectId": "replace-with-firebase-project-id",
    "firestoreLocation": "nam5"
  },
  "firebase": {
    "apiKey": "replace-with-web-api-key",
    "authDomain": "replace-with-firebase-project-id.firebaseapp.com",
    "storageBucket": "replace-with-firebase-project-id.firebasestorage.app",
    "messagingSenderId": "replace-with-sender-id",
    "appId": "replace-with-web-app-id"
  },
  "repository": {
    "slug": "owner/repository",
    "defaultBranch": "main"
  },
  "admin": {
    "ownerName": "Project owner",
    "ownerEmail": "owner@example.com",
    "defaultCollaboratorName": "Collaborator"
  },
  "automation": {
    "defaultMachineId": "local-mac",
    "defaultMachineLabel": "Local Mac",
    "defaultWorkAgent": "sol",
    "defaultDeployAgent": "sonnet",
    "stateDirectory": ".project-admin",
    "logDirectoryName": "ProjectAdminAgentLoops"
  },
  "agents": [
    {
      "token": "sol",
      "label": "Codex Sol",
      "short": "Sol",
      "emoji": "☀️",
      "runner": "codex",
      "model": "gpt-5.6-sol"
    },
    {
      "token": "terra",
      "label": "Codex Terra",
      "short": "Terra",
      "emoji": "🌍",
      "runner": "codex",
      "model": "gpt-5.6-terra"
    },
    {
      "token": "luna",
      "label": "Codex Luna",
      "short": "Luna",
      "emoji": "🌙",
      "runner": "codex",
      "model": "gpt-5.6-luna"
    },
    {
      "token": "opus",
      "label": "Claude Opus",
      "short": "Opus",
      "emoji": "◆",
      "runner": "claude",
      "model": "opus",
      "claimsUnassigned": true
    },
    {
      "token": "sonnet",
      "label": "Claude Sonnet",
      "short": "Sonnet",
      "emoji": "⚡",
      "runner": "claude",
      "model": "sonnet"
    },
    {
      "token": "fable",
      "label": "Claude Fable",
      "short": "Fable",
      "emoji": "◇",
      "runner": "claude",
      "model": "fable"
    },
    {
      "token": "grok",
      "label": "Grok",
      "short": "Grok",
      "emoji": "✕",
      "runner": "grok",
      "model": "grok",
      "pollSeconds": 1800
    }
  ],
  "agentAliases": {
    "codex": "terra",
    "claude": "sonnet"
  },
  "deployments": {
    "firebaseHosting": true,
    "firebaseFunctions": true,
    "firebaseRulesIndexes": true,
    "vercel": false,
    "flutterWeb": false,
    "cloudRun": false,
    "testflight": false
  }
}
