{
  "$schema": "./project-admin.config.schema.json",
  "schemaVersion": 1,
  "project": {
    "name": "My Project",
    "shortName": "My Project",
    "slug": "my-project",
    "description": "Product operations and autonomous delivery control room",
    "productionUrl": "https://example.com",
    "vercelProductionUrl": "https://example.com",
    "adminPath": "/admin",
    "firebaseProjectId": "replace-with-firebase-project-id",
    "firestoreLocation": "nam5"
  },
  "firebase": {
    "apiKey": "replace-with-web-api-key",
    "authDomain": "replace-with-firebase-project-id.firebaseapp.com",
    "storageBucket": "replace-with-firebase-project-id.firebasestorage.app",
    "messagingSenderId": "replace-with-sender-id",
    "appId": "replace-with-web-app-id"
  },
  "repository": {
    "slug": "owner/repository",
    "defaultBranch": "main"
  },
  "workKinds": {
    "feature": {
      "label": "Feature request",
      "pluralLabel": "Feature Requests",
      "prefix": "FR",
      "route": "features",
      "planReview": false,
      "deploys": true,
      "runbook": ".claude/commands/feature-loop.md",
      "statuses": { "initial": "backlog", "done": "shipped", "declined": "declined" }
    },
    "bug": {
      "label": "Bug",
      "pluralLabel": "Bugs",
      "prefix": "BUG",
      "route": "bugs",
      "planReview": true,
      "deploys": true,
      "runbook": ".claude/commands/bug-loop.md",
      "statuses": { "initial": "open", "done": "closed", "declined": "wont_fix" }
    },
    "task": {
      "label": "Task",
      "pluralLabel": "Tasks",
      "prefix": "TASK",
      "route": "tasks",
      "planReview": false,
      "deploys": false,
      "runbook": ".claude/commands/task-loop.md",
      "statuses": { "initial": "open", "done": "closed", "declined": "declined" },
      "icon": "check",
      "tone": "blue",
      "copy": { "eyebrow": "Chores and research", "createLabel": "task" }
    }
  },
  "admin": {
    "ownerName": "Project owner",
    "ownerEmail": "owner@example.com",
    "defaultCollaboratorName": "Collaborator"
  },
  "automation": {
    "defaultMachineId": "local-mac",
    "defaultMachineLabel": "Local Mac",
    "defaultWorkAgent": "sol",
    "defaultDeployAgent": "sonnet",
    "stateDirectory": ".project-admin",
    "logDirectoryName": "ProjectAdminAgentLoops"
  },
  "agents": [
    {
      "token": "sol",
      "label": "Codex Sol",
      "short": "Sol",
      "emoji": "☀️",
      "runner": "codex",
      "model": "gpt-5.6-sol"
    },
    {
      "token": "terra",
      "label": "Codex Terra",
      "short": "Terra",
      "emoji": "🌍",
      "runner": "codex",
      "model": "gpt-5.6-terra"
    },
    {
      "token": "luna",
      "label": "Codex Luna",
      "short": "Luna",
      "emoji": "🌙",
      "runner": "codex",
      "model": "gpt-5.6-luna"
    },
    {
      "token": "opus",
      "label": "Claude Opus",
      "short": "Opus",
      "emoji": "◆",
      "runner": "claude",
      "model": "opus",
      "claimsUnassigned": true
    },
    {
      "token": "sonnet",
      "label": "Claude Sonnet",
      "short": "Sonnet",
      "emoji": "⚡",
      "runner": "claude",
      "model": "sonnet"
    },
    {
      "token": "fable",
      "label": "Claude Fable",
      "short": "Fable",
      "emoji": "◇",
      "runner": "claude",
      "model": "fable"
    },
    {
      "token": "grok",
      "label": "Grok",
      "short": "Grok",
      "emoji": "✕",
      "runner": "grok",
      "model": "grok",
      "pollSeconds": 1800
    }
  ],
  "agentAliases": {
    "codex": "terra",
    "claude": "sonnet"
  },
  "notifications": {
    "desktop": true,
    "webhook": { "urlEnv": "PROJECT_ADMIN_NOTIFY_WEBHOOK_URL", "format": "json" }
  },
  "deployments": {
    "targets": {
      "testflight": { "enabled": false },
      "firebase_hosting": {},
      "firebase_functions": {},
      "firebase_rules_indexes": {},
      "vercel": { "enabled": false },
      "flutter_web": { "enabled": false },
      "cloud_run": { "enabled": false }
    }
  }
}
