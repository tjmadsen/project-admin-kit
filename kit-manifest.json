{
  "$comment": "Which files belong to the kit (replaced or 3-way merged by `npm run kit:upgrade`) and which belong to the project (never touched by an upgrade). A path matching projectOwned is the project's even when it also matches kitOwned; a path matching neither is ignored. exclude lists generated or machine-local paths that the installer, scaffolder, and upgrader never copy. See docs/UPGRADING.md.",
  "name": "project-admin-kit",
  "version": "0.2.0",
  "kitOwned": [
    ".claude/commands/**",
    ".github/workflows/ci.yml",
    ".gitignore",
    ".nvmrc",
    ".firebaserc.example",
    "AGENTS.md",
    "CHANGELOG.md",
    "CLAUDE.md",
    "Dockerfile.loops",
    "LICENSE",
    "admin-app/**",
    "docs/**",
    "extras/**",
    "firestore.indexes.json",
    "firestore.rules",
    "kit-manifest.json",
    "package.json",
    "project-admin.config.schema.json",
    "scripts/**",
    "storage.rules"
  ],
  "projectOwned": [
    ".firebaserc",
    ".project-admin/**",
    "README.md",
    "auth.env",
    "extras/functions/project-config.json",
    "extras/native-ios/GoogleService-Info.plist",
    "extras/native-ios/ProjectAdminConfig.json",
    "firebase.json",
    "project-admin.config.json",
    "public/**",
    "scripts/agent-loops/machine-roster.json"
  ],
  "exclude": [
    "**/node_modules",
    "**/node_modules/**",
    "**/.DS_Store",
    ".agent-logs/**",
    ".agent-worktrees/**",
    ".firebase/**",
    ".git/**",
    "admin-app/.env.local",
    "auth.env",
    "extras/native-ios/*.xcodeproj/**",
    "extras/native-ios/GoogleService-Info.plist",
    "*.log",
    ".project-admin/kit-lock.json",
    ".project-admin/demo/**"
  ]
}
