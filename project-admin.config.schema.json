{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-admin.local/project-admin.config.schema.json",
  "title": "Project Admin configuration",
  "type": "object",
  "required": ["schemaVersion", "project", "repository", "admin", "automation", "deployments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["name", "shortName", "slug", "productionUrl", "adminPath", "firestoreLocation"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "description": { "type": "string" },
        "productionUrl": { "type": "string", "format": "uri" },
        "vercelProductionUrl": { "type": "string", "format": "uri" },
        "adminPath": { "type": "string", "pattern": "^/" },
        "firebaseProjectId": { "type": "string", "minLength": 1 },
        "firestoreLocation": { "type": "string", "minLength": 1 }
      }
    },
    "firebase": {
      "type": "object",
      "required": ["apiKey", "authDomain", "storageBucket", "messagingSenderId", "appId"],
      "additionalProperties": { "type": "string" }
    },
    "repository": {
      "type": "object",
      "required": ["slug", "defaultBranch"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "defaultBranch": { "type": "string", "minLength": 1 }
      }
    },
    "layout": {
      "description": "Where the kit sits relative to the product repository (docs/LAYOUTS.md). Absent means the kit is the product repository.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "productRoot": { "type": "string", "minLength": 1, "default": ".", "description": "Product checkout, relative to the kit directory or absolute: \".\" (the kit is the repository), \"..\" (embedded in a subdirectory), or another checkout (separate)." }
      }
    },
    "backend": {
      "description": "Backlog and telemetry store (docs/BACKENDS.md). Absent means firestore.",
      "oneOf": [
        { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "const": "firestore" } } },
        {
          "type": "object", "required": ["type"], "additionalProperties": false,
          "properties": {
            "type": { "const": "local" },
            "path": { "type": "string", "minLength": 1, "description": "JSON store file; relative paths resolve against your home directory. Default ~/<automation.stateDirectory>/<project.slug>/store.json." }
          }
        },
        {
          "type": "object", "required": ["type"], "additionalProperties": false,
          "properties": {
            "type": { "const": "github" },
            "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$", "description": "owner/repo whose Issues hold the backlog. Default repository.slug." },
            "labelPrefix": { "type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,20}$", "description": "Prefix for lifecycle labels. Default \"pa:\"." }
          }
        }
      ]
    },
    "workKinds": {
      "description": "Work item kinds keyed by id. Omit for the built-in feature + bug pair. Fields left out fall back to the built-in kind with the same id (scripts/lib/work-kinds.defaults.json), then to generic defaults. Run `npm run sync:work-kinds` after editing.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$",
        "not": {
          "const": "deploy"
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Singular name, e.g. \"Feature request\""
          },
          "pluralLabel": {
            "type": "string",
            "minLength": 1
          },
          "shortLabel": {
            "type": "string",
            "minLength": 1,
            "description": "Compact plural for dashboards, e.g. \"Features\""
          },
          "prefix": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*$",
            "description": "Item reference prefix, e.g. FR in FR-12"
          },
          "route": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Admin URL segment; defaults to <id>s"
          },
          "planReview": {
            "type": "boolean",
            "description": "Require an investigation and plan_review gate before implementation"
          },
          "deploys": {
            "type": "boolean",
            "description": "true: release through the deploy queue; false: close with close-no-deploy"
          },
          "runbook": {
            "type": "string",
            "description": "Canonical loop runbook; defaults to .claude/commands/<id>-loop.md"
          },
          "statuses": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "initial": {
                "enum": [
                  "backlog",
                  "open"
                ]
              },
              "done": {
                "enum": [
                  "shipped",
                  "closed"
                ]
              },
              "declined": {
                "enum": [
                  "declined",
                  "wont_fix"
                ]
              }
            }
          },
          "icon": {
            "enum": [
              "spark",
              "bug",
              "check"
            ]
          },
          "tone": {
            "enum": [
              "green",
              "amber",
              "blue",
              "violet"
            ]
          },
          "copy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "eyebrow": {
                "type": "string"
              },
              "adminDescription": {
                "type": "string"
              },
              "collaboratorDescription": {
                "type": "string"
              },
              "createLabel": {
                "type": "string",
                "description": "Noun on the create button, e.g. \"request\""
              },
              "statDetail": {
                "enum": [
                  "queued",
                  "critical"
                ]
              }
            }
          }
        }
      }
    },
    "admin": {
      "type": "object",
      "required": ["ownerName", "ownerEmail", "defaultCollaboratorName"],
      "properties": {
        "ownerName": { "type": "string", "minLength": 1 },
        "ownerEmail": { "type": "string", "format": "email" },
        "defaultCollaboratorName": { "type": "string", "minLength": 1 }
      }
    },
    "automation": {
      "type": "object",
      "required": ["defaultMachineId", "defaultMachineLabel", "defaultWorkAgent", "defaultDeployAgent", "stateDirectory", "logDirectoryName"],
      "properties": {
        "scheduler": {
          "enum": ["launchd", "systemd", "cron", "foreground"],
          "description": "How provision-machine.sh schedules loops. Default: launchd on macOS, systemd (user timers) on Linux, foreground (npm run loops) elsewhere."
        }
      },
      "additionalProperties": { "type": "string" }
    },
    "notifications": {
      "description": "Loop alert channels (e.g. an expired headless CLI session). Omit for a desktop alert only.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "desktop": { "type": "boolean", "description": "osascript on macOS, notify-send on Linux when installed; default true." },
        "webhook": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "urlEnv": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$", "description": "Environment variable holding the webhook URL (default PROJECT_ADMIN_NOTIFY_WEBHOOK_URL). Nothing is sent while it is unset." },
                "format": { "enum": ["json", "slack", "ntfy"], "description": "json: POST {title, message, level}; slack: incoming-webhook {text}; ntfy: plain body with Title/Priority/Tags headers." }
              }
            }
          ]
        }
      }
    },
    "deployments": {
      "description": "Deploy targets the deploy loop may execute. Use { \"targets\": { ... } }; the legacy flat boolean map (firebaseHosting, testflight, ...) still loads and keeps every built-in target enabled. Omit for every built-in target. `none` is built in and reserved.",
      "oneOf": [
        {
          "type": "object",
          "required": ["targets"],
          "additionalProperties": false,
          "properties": {
            "targets": {
              "type": "object",
              "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$", "not": { "enum": ["none", "mixed"] } },
              "additionalProperties": { "$ref": "#/$defs/deployTarget" }
            }
          }
        },
        {
          "description": "Legacy shape: booleans keyed by firebaseHosting, firebaseFunctions, firebaseRulesIndexes, vercel, flutterWeb, cloudRun, testflight.",
          "type": "object",
          "not": { "required": ["targets"] },
          "additionalProperties": { "type": "boolean" }
        }
      ]
    },
    "agents": {
      "description": "Selectable loop agents. Omit to use the built-in roster in scripts/lib/agent-defaults.json. Each agent's queue owner is <token>-agent.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/agent" }
    },
    "agentAliases": {
      "description": "Legacy or shorthand tokens mapped to a configured agent token, e.g. { \"codex\": \"terra\" }.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    }
  },
  "allOf": [
    {
      "description": "The firestore backend (the default) needs the Firebase web app and project identity.",
      "if": { "anyOf": [{ "not": { "required": ["backend"] } }, { "properties": { "backend": { "properties": { "type": { "const": "firestore" } } } } }] },
      "then": { "required": ["firebase"], "properties": { "project": { "required": ["firebaseProjectId"] } } }
    }
  ],
  "$defs": {
    "deployTarget": {
      "type": "object",
      "additionalProperties": false,
      "description": "Built-in ids (testflight, firebase_hosting, firebase_functions, firebase_rules_indexes, vercel, flutter_web, cloud_run) may omit label and runbook; see scripts/lib/deploy-targets.defaults.json.",
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "runbook": { "type": "string", "minLength": 1, "description": "Repository-relative markdown runbook with the target's preconditions, commands, live proof, and known failures." },
        "requiresHumanAcceptance": { "type": "boolean", "description": "The deploy loop records proof but returns the item to acceptance review instead of closing it." },
        "enabled": { "type": "boolean", "description": "false hides the target from the admin picker and rejects new selections; recorded scopes still resolve." }
      }
    },
    "agent": {
      "type": "object",
      "required": ["token", "label", "runner", "model"],
      "additionalProperties": false,
      "properties": {
        "token": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "not": { "const": "configured" } },
        "label": { "type": "string", "minLength": 1 },
        "short": { "type": "string", "minLength": 1 },
        "emoji": { "type": "string", "minLength": 1 },
        "runner": { "enum": ["claude", "codex", "grok", "command"] },
        "model": { "type": "string", "minLength": 1 },
        "claimsUnassigned": { "type": "boolean", "description": "Also claim work with no assigned owner." },
        "pollSeconds": { "type": "integer", "minimum": 1, "description": "launchd poll interval for this agent's build loops (default 300)." },
        "sandbox": { "enum": ["read-only", "workspace-write", "danger-full-access"], "description": "Codex --sandbox mode (default danger-full-access)." },
        "usage": {
          "description": "Usage-capture hook run on every poll; false disables the runner's default.",
          "oneOf": [
            { "const": false },
            {
              "type": "object",
              "required": ["provider", "script"],
              "additionalProperties": false,
              "properties": {
                "provider": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "script": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "command": {
          "description": "command runner only: argv template; placeholders {{prompt}}, {{prompt_file}}, {{model}}, {{effort}}, {{repo}}.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "promptVia": { "enum": ["arg", "stdin"], "description": "command runner only: pass the prompt through the template (arg) or on stdin." }
      }
    }
  }
}
